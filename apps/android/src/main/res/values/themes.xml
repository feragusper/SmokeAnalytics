<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Post-splash app theme. Plain AppCompat NoActionBar shell; Compose owns the real look.
      DayNight (not the old fixed .Light) so the window background follows the system light/dark
      setting: under edge-to-edge enforcement the system bars are transparent, so the window
      background is what shows behind the status-bar strip before/between Compose frames. A fixed
      light background there left white dark-mode bar icons on a white strip (invisible). The
      explicit windowBackground tracks the Compose scheme background exactly (see @color/window_background).
    -->
    <style name="Theme.SmokeAnalytics" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
      System splash shown on cold start (Android 12+ native, backported below via
      core-splashscreen). Brand teal background with the launcher logo, then hands off to
      the animated Compose splash inside MainActivity. Keep the background in sync with the
      Compose splash so the transition reads as one continuous screen.
    -->
    <style name="Theme.SmokeAnalytics.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.SmokeAnalytics</item>
    </style>

</resources>
